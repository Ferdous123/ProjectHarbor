# ProjectHarbor Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# === JUPYTER ===
JUPYTER_TOKEN=change_me_to_a_secure_token
JUPYTER_PORT=8888

# === AGENT ===
AGENT_PORT=9111
AGENT_API_KEY=
# Leave blank on first run — agent auto-generates and writes it here

# === PATHS (adjust to your machine) ===
JUPYTER_ENV_PATH=F:\Research_Paper_Projects\Thesis\physicsdp_env
JUPYTER_NOTEBOOK_DIR=F:\Research_Paper_Projects\Thesis
PROJECT_DIR=F:\Research_Paper_Projects\ProjectHarbor

# === OPTIONAL ===
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# AUTO_COMMIT_REPO=F:\Research_Paper_Projects\Thesis
