{
  "jupyter_watchdog": true,
  "jupyter_watchdog_interval_sec": 15,
  "metrics_interval_sec": 30,
  "metrics_retention_hours": 48,
  "process_snapshot_interval_sec": 60,
  "auto_commit_enabled": false,
  "auto_commit_interval_min": 60,
  "auto_commit_message_prefix": "auto: ",
  "allowed_origins": [
    "*"
  ],
  "bind_host": "0.0.0.0",
  "_comment_jupyter": "Jupyter settings are per-instance (not per-project in this simple setup)",
  "jupyter_token": "",
  "jupyter_port": 8888,
  "jupyter_env_path": "",
  "jupyter_notebook_dir": ""
}
